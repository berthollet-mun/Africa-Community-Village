# Restricted runtime account. Keep the pool small for serverless Netlify functions.
DATABASE_URL="mysql://acv_app:change-me@127.0.0.1:3306/acv?connection_limit=2&pool_timeout=10&connect_timeout=10"

# Direct administrative connection used only for migrations and database objects.
DIRECT_URL="mysql://acv_migration:change-me@127.0.0.1:3306/acv"

# Use a long random value (at least 32 characters) in every deployed environment.
AUTH_SECRET="replace-with-a-long-random-secret"

# Initial password used only by `npm run prisma:seed` (12 characters minimum).
SEED_ADMIN_PASSWORD="replace-with-a-strong-initial-password"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
